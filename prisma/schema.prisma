generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id           String        @id @default(uuid())
  name         String
  timezone     String
  patients     Patient[]
  appointments Appointment[]
}

model Patient {
  id               String  @id @default(uuid())
  clinicId         String
  name             String
  phone            String?
  acceptsReminders Boolean

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  appointments Appointment[]

  @@index([clinicId])
}

enum AppointmentStatus {
  scheduled
  confirmed
  cancelled
}

enum ReminderStatus {
  pending
  sent
  failed
  skipped
  cancelled
}

enum ReminderSkipReason {
  too_late
  no_phone
  opted_out
}

model Appointment {
  id        String            @id @default(uuid())
  clinicId  String
  patientId String
  startsAt  DateTime          @db.Timestamptz(3)
  status    AppointmentStatus @default(scheduled)

  clinic    Clinic     @relation(fields: [clinicId], references: [id])
  patient   Patient    @relation(fields: [patientId], references: [id])
  reminders Reminder[]

  @@index([clinicId, startsAt])
  @@index([patientId])
}

model Reminder {
  id            String              @id @default(uuid())
  appointmentId String
  scheduledFor  DateTime            @db.Timestamptz(3)
  status        ReminderStatus      @default(pending)
  attempts      Int                 @default(0)
  sentAt        DateTime?           @db.Timestamptz(3)
  skipReason    ReminderSkipReason?

  nextAttemptAt DateTime?   @db.Timestamptz(3)
  leaseUntil    DateTime?   @db.Timestamptz(3)
  claimToken    String?
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  @@index([status, scheduledFor])
  @@index([appointmentId])
}

model InboundMessage {
  messageId  String   @id
  from       String
  text       String
  receivedAt DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
}
