generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id       String    @id @default(uuid())
  name     String
  timezone String
  patients Patient[]
}

model Patient {
  id               String  @id @default(uuid())
  clinicId         String
  name             String
  phone            String?
  acceptsReminders Boolean

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
}
